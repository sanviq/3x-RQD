# Reference values only. FastAPI reads the process environment; it does not load this file.
# PowerShell example: $env:ROAD_HEALTH_MAP_LATITUDE = '12.9716'
ROAD_HEALTH_MAP_LATITUDE=12.9716
ROAD_HEALTH_MAP_LONGITUDE=77.5946
ROAD_HEALTH_MAP_LOCATION=Bengaluru default map view
ROAD_HEALTH_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
ROAD_HEALTH_TILE_ATTRIBUTION=© OpenStreetMap contributors · ODbL
ROAD_HEALTH_OVERPASS_URL=https://overpass-api.de/api/interpreter
ROAD_HEALTH_GEOCODER_URL=https://photon.komoot.io/api/
# Use server-only credentials if your compatible provider requires them:
# ROAD_HEALTH_OVERPASS_API_KEY=
# ROAD_HEALTH_GEOCODER_API_KEY=
# Only browser-public keys may be used for tiles, whose URL contains {apikey}:
# ROAD_HEALTH_TILE_PUBLIC_KEY=
# ROAD_HEALTH_DATA_DIR=
